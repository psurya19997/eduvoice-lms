VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only. Used by scripts/seed-reference.mjs. Do NOT expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side only. Used by scripts/preview-tts.mjs and scripts/seed-storyteller.mjs.
# Google Cloud Text-to-Speech API key (AIza...). Do NOT expose to client.
GOOGLE_TTS_API_KEY=your-google-tts-api-key
